<!DOCTYPE html>
<html lang="en">
<head>

    <style>
        h1{
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home pages</title>
</head>
<body>
    <h1> Url shortner</h1>

    <% if(locals.id) { %>
        <p> uRl genrate: http://localhost:8002/<%=id %></p>
    <%} %>

    <form method="post" action="/url" >
        <label>Enter your origional url</label> <br><br>
        <input type="text" name="url" placeholder="https://example.com"> <br><br>

        <button type="submit"> Genrate</button>
    </form>
<div>
    <% if (locals.urls) { %>

        <table border="1">
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Short ID</th>
                    <th>Redirect</th>
                    <th>Clicks</th>
                </tr>
            </thead>

            <tbody>
                <% urls.forEach((url, index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= url.shortId %>
                        </td>
                        <td>
                            <%= url.redirectUrl %>
                        </td>
                        <td>
                            <%= url.visitHistory.length %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>

        <% } %>
</div>
    
</body>
</html>